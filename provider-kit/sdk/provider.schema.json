{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hongguo Provider v1",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "name": {
      "type": "string",
      "maxLength": 80,
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "entry": {
      "type": "string",
      "pattern": "\\.mjs$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 240,
        "minLength": 1
      },
      "maxItems": 256
    },
    "queryMode": {
      "enum": [
        "link",
        "search"
      ]
    },
    "authentication": {
      "const": "qrcode"
    },
    "queryHint": {
      "type": "string",
      "maxLength": 160
    },
    "emptyMessage": {
      "type": "string",
      "maxLength": 160
    },
    "enabled": {
      "type": "boolean"
    },
    "nsfw": {
      "type": "boolean"
    },
    "contentTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,23}$"
          },
          "name": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1
          },
          "queryHint": {
            "type": "string",
            "maxLength": 160
          },
          "emptyMessage": {
            "type": "string",
            "maxLength": 160
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]{0,24}$"
                },
                "name": {
                  "type": "string",
                  "maxLength": 40,
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "name"
              ]
            },
            "maxItems": 32
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "maxItems": 8,
      "minItems": 1
    },
    "network": {
      "type": "object",
      "properties": {
        "api": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(\\*\\.)?([a-zA-Z0-9-]+\\.)+[a-zA-Z]{2,}$"
          },
          "maxItems": 32
        },
        "media": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(\\*\\.)?([a-zA-Z0-9-]+\\.)+[a-zA-Z]{2,}$"
          },
          "maxItems": 32
        }
      }
    },
    "discovery": {
      "type": "boolean"
    },
    "progressivePlayback": {
      "type": "boolean"
    },
    "recommendationTerms": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 30
      }
    }
  },
  "required": [
    "apiVersion",
    "id",
    "name",
    "version",
    "entry"
  ]
}
