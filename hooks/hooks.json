{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/bin/run-node\" hook",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -Command \"& ([IO.Path]::Combine([Environment]::GetEnvironmentVariable('PLUGIN_ROOT'), 'bin', 'run-node.exe')) hook; exit (Get-Variable LASTEXITCODE -ValueOnly -ErrorAction Stop)\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/bin/run-node\" hook",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -Command \"& ([IO.Path]::Combine([Environment]::GetEnvironmentVariable('PLUGIN_ROOT'), 'bin', 'run-node.exe')) hook; exit (Get-Variable LASTEXITCODE -ValueOnly -ErrorAction Stop)\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/bin/run-node\" hook",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -Command \"& ([IO.Path]::Combine([Environment]::GetEnvironmentVariable('PLUGIN_ROOT'), 'bin', 'run-node.exe')) hook; exit (Get-Variable LASTEXITCODE -ValueOnly -ErrorAction Stop)\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
