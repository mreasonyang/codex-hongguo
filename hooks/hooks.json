{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/bin/run-node\" hook",
            "commandWindows": "$ErrorActionPreference = 'Stop'; $OutputEncoding = [Text.UTF8Encoding]::new($false); ([IO.StreamReader]::new([Console]::OpenStandardInput(), [Text.Encoding]::UTF8)).ReadToEnd() | & \"$env:PLUGIN_ROOT\\bin\\run-node.exe\" hook; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/bin/run-node\" hook",
            "commandWindows": "$ErrorActionPreference = 'Stop'; $OutputEncoding = [Text.UTF8Encoding]::new($false); ([IO.StreamReader]::new([Console]::OpenStandardInput(), [Text.Encoding]::UTF8)).ReadToEnd() | & \"$env:PLUGIN_ROOT\\bin\\run-node.exe\" hook; exit $LASTEXITCODE",
            "timeout": 3
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/bin/run-node\" hook",
            "commandWindows": "$ErrorActionPreference = 'Stop'; $OutputEncoding = [Text.UTF8Encoding]::new($false); ([IO.StreamReader]::new([Console]::OpenStandardInput(), [Text.Encoding]::UTF8)).ReadToEnd() | & \"$env:PLUGIN_ROOT\\bin\\run-node.exe\" hook; exit $LASTEXITCODE",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
